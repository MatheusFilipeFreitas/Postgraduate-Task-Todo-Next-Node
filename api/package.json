{
  "name": "task-todo-api",
  "version": "1.0.0",
  "description": "Task Todo Express API with JWT auth and PostgreSQL storage",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prestart": "tsc",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --wait && npm run db:setup",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f postgres",
    "docker:reset": "docker compose -f docker/docker-compose.yml down -v",
    "db:migrate": "node-pg-migrate -j ts -m migrations up",
    "db:migrate:down": "node-pg-migrate -j ts -m migrations down",
    "db:migrate:create": "node-pg-migrate -j ts -m migrations create",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/db-setup.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.16.3",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.15",
    "@types/pg": "^8.15.4",
    "typescript": "^5.8.3"
  }
}
